<!--
 app_name / launcher_name / activity_name are generated by cordova-android
 (>=15) into cdv_strings.xml from the <name> in config.xml. Defining them here
 too would be a duplicate-resource error at :app:mergeReleaseResources, so they
 are intentionally omitted from this base file. The localized values-*/strings.xml
 files still carry them (harmless per-locale overrides with the same value) and
 are left untouched to avoid a 60-file churn.
-->
<resources>
    <string name="connected_server_state">Connected</string>
    <string name="reconnecting_server_state">Reconnecting...</string>
    <string name="server_default_name_outline">Outline Server</string>
</resources>
