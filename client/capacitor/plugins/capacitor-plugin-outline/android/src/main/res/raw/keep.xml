<!--
  Resources that are resolved by name at runtime (Resources.getIdentifier)
  rather than through the generated R class. The release build's resource
  shrinker only follows R references, so it treats these as unused and
  removes them unless they are listed here. When adding a name-based lookup,
  add its resource.

  @drawable/small_icon               VpnTunnelService: notification icon
  @array/reserved_bypass_subnets     VpnTunnelService: routes added to the VPN
  @string/connected_server_state     VpnTunnelService: notification text
  @string/reconnecting_server_state  VpnTunnelService: notification text
  @drawable/splash                   SplashScreen plugin: androidSplashResourceName
                                     in capacitor.config.json
  (VpnTunnelService is in OutlineAndroidLib; see getResourceId() there.)
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="
        @drawable/small_icon,
        @array/reserved_bypass_subnets,
        @string/connected_server_state,
        @string/reconnecting_server_state,
        @drawable/splash
    " />
