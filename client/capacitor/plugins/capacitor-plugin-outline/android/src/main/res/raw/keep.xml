<!--
  Resources VpnTunnelService (OutlineAndroidLib) looks up by name through
  Resources.getIdentifier(), which the release build's resource shrinker
  cannot see. AGP 9 removes them (the Capacitor 9 upgrade), and the VPN then
  fails to start with "String array resource ID #0x0".
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/reserved_bypass_subnets,@drawable/small_icon" />
