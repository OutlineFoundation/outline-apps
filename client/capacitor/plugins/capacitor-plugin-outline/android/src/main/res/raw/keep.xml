<!--
  Resources that are resolved by name at runtime (Resources.getIdentifier)
  rather than through the generated R class. The release build's resource
  shrinker only follows R references, so it treats these as unused and
  removes them unless they are listed here.

  - VpnTunnelService (OutlineAndroidLib) resolves its notification icon, the
    notification status strings and the bypass subnet list by name; see
    getResourceId() there.
  - The Capacitor SplashScreen plugin resolves the splash drawable by the
    name in capacitor.config.json.

  When adding a name-based lookup, add its resource here.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/small_icon,@array/reserved_bypass_subnets,@string/connected_server_state,@string/reconnecting_server_state,@drawable/splash" />
