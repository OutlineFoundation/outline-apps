<?xml version="1.0" encoding="UTF-8"?>
<!--
  Workspace for the Mac Catalyst build only.

  It wraps App.xcodeproj together with the local capacitor-swift-pm package,
  which makes Xcode use that package (self-built Capacitor xcframeworks with a
  Mac Catalyst slice) in place of the remote capacitor-swift-pm binary package
  for every package in the dependency graph. Building App.xcodeproj directly
  (the iOS build) keeps using the remote package.
-->
<Workspace
   version = "1.0">
   <FileRef
      location = "group:App.xcodeproj">
   </FileRef>
   <FileRef
      location = "group:../capacitor-swift-pm">
   </FileRef>
</Workspace>
